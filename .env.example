# ---------------------------------------------------------------------------
# Copy this file to `.env` and edit it.   (macOS/Linux: cp .env.example .env
#                                           Windows:     copy .env.example .env)
# Lines starting with # are ignored. NEVER commit your real .env to Git (.gitignore already excludes it).
# ---------------------------------------------------------------------------

# 1) WHICH LLM? -------------------------------------------------------------
# mock = rule-based stand-ins (no network). Use for CI / first offline run.
# ollama = local grounded policy answers (Milestone 1). Requires: ollama pull <model>
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# EMBEDDER=wordllama          # or fastembed (BAAI/bge-small-en-v1.5)
# ollama pull qwen2.5:7b      # or any local model you prefer

# --- Free / cheap options (pick ONE, uncomment its lines) -------------------
# Google Gemini (free tier; key from https://aistudio.google.com/apikey)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-key
# LLM_MODEL=gemini-3.8-flash

# Groq (free plan with rate limits; key from https://console.groq.com/keys)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-key
# LLM_MODEL=openai/gpt-oss-20b

# Ollama (100% local and free; install from https://ollama.com, then: ollama pull qwen3:8b)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b

# OpenRouter (DeepSeek etc.; key from https://openrouter.ai)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-key
# LLM_MODEL=deepseek/deepseek-chat

# --- Paid options -----------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key
# LLM_MODEL=gpt-6-luna

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key
# LLM_MODEL=claude-haiku-5-5

# Optional: a cheaper model for claim extraction only (model routing). Empty = same model.
# LLM_SMALL_MODEL=
# LLM_TEMPERATURE=0

# 2) WHICH SEARCH? ----------------------------------------------------------
# offline = the fictional vendor web in data/vendor_web/corpus.json (repeatable, safe, free)
SEARCH_PROVIDER=offline
# ddgs    = real web search, no key needed          (pip install ddgs trafilatura)
# SEARCH_PROVIDER=ddgs
# tavily  = real web search API built for agents    (free monthly credits at https://tavily.com)
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-your-key
# cache   = only search cached_pages/ (offline demo of live path)
# SEARCH_PROVIDER=cache

# 3) AGENT SETTINGS (defaults are fine) --------------------------------------
# VRA_AS_OF=2026-11-01         # "today" for freshness maths (offline mode pins this date from the corpus)
# VRA_MAX_USD=0.50             # hard budget per assessment in live mode
# VRA_MAX_PARALLEL=6
# VRA_MAX_PLAN_ITERATIONS=1    # 1 is enough when official seeds + site: queries hit
# VRA_RESULTS_PER_QUERY=3
# VRA_MAX_PAGES=5              # cap fetch+extract pages (main latency lever)
# VRA_LLM_PLAN=0               # 1 = LLM Plan Creator (slow on local 7b); 0 = mock plan + reviewer
# VRA_PAGE_CACHE=1             # 1 = prefer cached_pages/ snapshots (faster re-runs)
# VRA_VENDOR_MEMORY=1          # 1 = skip unchanged URLs on re-review (data/vendor_memory/)
# VRA_IDENTITY_GATE=1          # 0 = M4/M6 ablation only (lookalike certs leak)
# VRA_RERANKER=1               # 0 = M6 ablation (policy RAG without reranker)
# VRA_FRESHNESS_DECAY=1        # 0 = M6 ablation (no half-life on claim scores)
# VRA_INJECTION_CLASSIFIER=1   # 1 = Layer-2 injection classifier behind regexes
# VRA_FORCE_LLM_ROUTER=0       # 1 = use LLM router even when SEARCH_PROVIDER=offline (M3 benchmark)
# VRA_VERBOSE=1
# PRICE_IN_PER_MTOK=0.10       # your model's real price per 1M input tokens (for cost estimates)
# PRICE_OUT_PER_MTOK=0.50

# 4) PRODUCT / M5 (API + queue + store) --------------------------------------
# Local Docker (optional):
# DATABASE_URL=postgresql://vra:vra@localhost:5433/vendor_risk
# REDIS_URL=redis://localhost:6379/0
#
# Cloud (recommended): Neon Postgres + Upstash Redis
#   Neon:    https://neon.tech  → Dashboard → Connection string (copy as DATABASE_URL)
#   Upstash: https://upstash.com → Redis → REST/CLI → copy TLS URL as REDIS_URL (rediss://)
# DATABASE_URL=postgresql://USER:PASS@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# REDIS_URL=rediss://default:TOKEN@xxxx.upstash.io:6379
#
# (empty DATABASE_URL = SQLite file data/assessor.db — fine for demos)
# QUEUE_NAME=assess
# VRA_INLINE_QUEUE=0           # 0 = use Redis+RQ; 1 = in-process (no Redis)
# VRA_CHECKPOINT_PATH=data/langgraph_checkpoints.sqlite
# VRA_API_BASE=http://127.0.0.1:8000
# VRA_SQLITE_PATH=data/assessor.db
#
# Smoke: python scripts/m5_cloud_smoke.py

